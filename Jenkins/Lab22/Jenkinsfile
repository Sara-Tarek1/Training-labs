pipeline {
    agent {
        label 'lab22-agent'
    }

    environment {
        DOCKER_IMAGE = 'saratarek1/demoapp'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Prepare Workspace') {
            steps {
                sh '''
                    tar -xzf /var/jenkins_home/lab22-source.tar.gz -C "$WORKSPACE"
                    ls -la
                '''
            }
        }

        stage('Load Shared Library') {
            steps {
                script {
                    library(
                        identifier: 'Lab22Shared@main',
                        retriever: modernSCM([
                            $class: 'GitSCMSource',
                            remote: 'file:///var/jenkins_home/lab22-shared-library'
                        ])
                    )
                }
            }
        }

        stage('CI/CD Pipeline') {
            steps {
                script {
                    buildApp()

                    buildImage(
                        env.DOCKER_IMAGE,
                        env.IMAGE_TAG
                    )

                    deployOnK8s(
                        env.DOCKER_IMAGE,
                        env.IMAGE_TAG
                    )
                }
            }
        }
    }
}
